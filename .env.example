# API token from the ChatPush dashboard (https://chatpush.ru) — local (stdio) mode only.
# In remote mode every caller sends their own token in the Authorization header.
CHATPUSH_TOKEN=your_token

# API host. Change only for awhite-label or self-hosted ChatPush installation.
CHATPUSH_BASE_URL=https://api.chatpush.ru

# --- remote mode (npm run start:http) ---
# Port and interface for the HTTP server.
# PORT=3000
# HOST=0.0.0.0
# Path of the MCP endpoint.
# CHATPUSH_MCP_PATH=/mcp
# Comma-separated Host values accepted by the server (DNS-rebinding protection).
# CHATPUSH_ALLOWED_HOSTS=mcp.chatpush.ru
# Allowed CORS origin, default *.
# CHATPUSH_ALLOWED_ORIGIN=*

# Set to 1 to log every request to stderr.
# CHATPUSH_DEBUG=0
