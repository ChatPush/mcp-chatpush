{
  "name": "chatpush-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for ChatPush — send WhatsApp, Telegram, MAX and SMS messages from AI agents",
  "type": "module",
  "bin": {
    "chatpush-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "build": "tsc && chmod +x dist/index.js dist/http.js",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "check": "node scripts/check.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "inspector": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "prepublishOnly": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChatPush/mcp-chatpush.git"
  },
  "keywords": [
    "mcp",
    "chatpush",
    "whatsapp",
    "telegram",
    "max",
    "sms",
    "messaging",
    "ai",
    "claude"
  ],
  "author": "ChatPush <support@chatpush.ru> (https://chatpush.ru)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ChatPush/mcp-chatpush/issues"
  },
  "homepage": "https://github.com/ChatPush/mcp-chatpush#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "dotenv": "^17.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^25.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "mcpName": "io.github.ChatPush/mcp-chatpush"
}
