{
  "name": "chatpush-mcp-server",
  "version": "1.1.1",
  "description": "MCP server for ChatPush: Claude and AI agents send WhatsApp, Telegram, MAX, SMS and VK messages, files and bulk mailings",
  "type": "module",
  "bin": {
    "chatpush-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example",
    "README.en.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "build": "tsc && chmod +x dist/index.js dist/http.js",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "check": "node scripts/check.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "inspector": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "prepublishOnly": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChatPush/mcp-chatpush.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-desktop",
    "claude-code",
    "cursor",
    "vscode",
    "ai-agent",
    "ai-agents",
    "whatsapp",
    "whatsapp-mcp",
    "whatsapp-api",
    "telegram",
    "telegram-mcp",
    "telegram-bot",
    "max",
    "max-messenger",
    "sms",
    "sms-api",
    "vk",
    "messaging",
    "bulk-messaging",
    "chatpush"
  ],
  "author": "ChatPush <support@chatpush.ru> (https://chatpush.ru)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ChatPush/mcp-chatpush/issues"
  },
  "homepage": "https://chatpush.ru/integrations/mcp",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "dotenv": "^17.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^25.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "mcpName": "io.github.ChatPush/whatsapp-telegram-max-sms"
}
